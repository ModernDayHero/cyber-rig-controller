// The Cyber Deck site on Cloudflare: a Worker that only serves the built files (dist/:
// the deck, guest.html, viz/), with public/_headers' security headers. Cloudflare's
// Git integration builds it from this repo:
//   build command   BASE=/ npm run build
//   deploy command  npx wrangler deploy
// The guest relay is its own Worker (worker/relay, relay.steamworkz.net).
{
  "name": "cyber-deck",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",   // / and unknown paths -> the deck
    "html_handling": "none"                            // guest.html stays guest.html: no redirects
  },
  "routes": [{ "pattern": "deck.steamworkz.net", "custom_domain": true }],
  "workers_dev": true
}
